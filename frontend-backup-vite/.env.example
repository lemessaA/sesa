# ── API Configuration ────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# ── LiveKit Configuration (for production live streaming) ────────────────────
# Get these from https://cloud.livekit.io after creating a project
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud
# Note: API keys are only needed on backend, frontend gets tokens from API

# ── App Configuration ─────────────────────────────────────────────────────────
VITE_APP_NAME=SESA Academy
VITE_APP_VERSION=2.0.0
