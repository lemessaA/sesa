# ── Copy to .env.local for overrides (never commit real secrets) ─────────────
# Vite exposes only variables prefixed with VITE_
#
# For `npm run dev`, committed frontend/.env.development sets the local API URL.
# Override here only if needed.

# VITE_API_URL=http://localhost:5000/api

VITE_APP_NAME=SESA Educational Platform
VITE_APP_DESCRIPTION=Full-stack educational platform with course management
VITE_APP_VERSION=1.0.0
