# Copy to .env in this folder: cp .env.example .env
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Optional: for LangGraph to pull a fresh dashboard from the Node API (recommend / app_help intents)
BACKEND_INTERNAL_API_BASE=http://127.0.0.1:5000/api

# RAG: same MongoDB URI as backend — stores chunks + vectors in `rag_chunks` (see atlas-vector-index.example.json for Atlas)
# MONGO_URI=mongodb+srv://...
# MONGODB_URI=   (alias)
# RAG_VECTOR_BACKEND=auto   # auto|mongo|chroma — auto uses Mongo when MONGO_URI is set, else Chroma
# RAG_MONGO_COLLECTION=rag_chunks
# RAG_ATLAS_VECTOR_INDEX=rag_vector_index  # name of Atlas Vector Search index; omit to use in-process cosine on Mongo reads (dev)
# RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
# RAG_DATA_DIR=  # Chroma only; default python-agents/data/rag
