# Copy to .env in this folder: cp .env.example .env
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Optional: for LangGraph to pull a fresh dashboard from the Node API (recommend / app_help intents)
BACKEND_INTERNAL_API_BASE=http://127.0.0.1:5000/api

# RAG: prefer Qdrant (set URL) in auto mode; else Mongo; else on-disk Chroma
# QDRANT_URL=http://127.0.0.1:6333   # requires Qdrant running: docker compose up -d qdrant
# If you see "connection refused" on upload, either start Qdrant or comment QDRANT_URL to use Chroma.
# RAG_QDRANT_COLLECTION=sesa_rag
# RAG_VECTOR_BACKEND=auto   # auto|qdrant|mongo|chroma — auto: Qdrant if QDRANT_URL, else Mongo if MONGO_URI, else Chroma
# MONGO_URI=mongodb+srv://...   (when using mongo backend)
# MONGODB_URI=   (alias)
# RAG_MONGO_COLLECTION=rag_chunks
# RAG_ATLAS_VECTOR_INDEX=rag_vector_index  # Atlas only; omit for in-process cosine (dev)
# RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
# RAG_EMBEDDING_DIM=   # optional; else inferred from the embedding model
# RAG_DATA_DIR=  # Chroma only; default python-agents/data/rag
