# ── Copy to .env and fill in values (never commit .env) ───────────────────────

# ── Primary database strategy ───────────────────────────────────────────────
# Production uses MongoDB Atlas as the durable primary database.
# Local MongoDB is only for development, seeding, and offline testing.
#
# ── Local development (everything on your machine) ──────────────────────────
# 1) Start MongoDB: docker compose up -d   (from repo root; see docker-compose.yml)
# 2) Set USE_LOCAL_DB=1 below so the API ignores Atlas and uses local MongoDB.
# 3) From backend/: npm run seed   (demo passwords per email, e.g. admin@sesa.com → admin123_Secure!)
#    Or: npm run seed:enhanced — same passwords for overlapping emails; extra roles use password123
# 4) Backend: npm run dev   Frontend: npm run dev   (frontend uses frontend/.env.development for API URL)

USE_LOCAL_DB=1

# ── MongoDB Atlas (production / Render — comment out USE_LOCAL_DB when using Atlas) ──
# Create a cluster at https://www.mongodb.com/atlas → Database Access (user) →
# Network Access (allow 0.0.0.0/0 for Render/Vercel or restrict by IP).
#
# Use either variable name (both are supported; MONGODB_URI is copied to MONGO_URI if needed):
#
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/DATABASE_NAME?retryWrites=true&w=majority
#
# If your password has special characters (@ # : / ? etc.), URL-encode it in the URI.
# Example database name: sesaApp (matches the path segment before ?)

MONGO_URI=
# MONGODB_URI=   # optional alias — same as MONGO_URI

# Optional MongoDB driver tuning (Atlas)
# MONGO_SERVER_SELECTION_MS=30000
# MONGO_DNS_FAMILY=ipv4   # default for mongodb+srv — use ipv6 if your network requires it

# If MONGO_URI is unset in development, not on Render, and USE_LOCAL_DB is not set:
# defaults to mongodb://127.0.0.1:27017/sesa_db
# In production, set MONGO_URI explicitly to your Atlas connection string.

# ── Core Server ───────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
APP_NAME=SESA Educational Platform
APP_VERSION=2.0.0

# ── Auth (required) ───────────────────────────────────────────────────────────
JWT_SECRET=your_long_random_jwt_secret_min_32_chars
JWT_REFRESH_SECRET=your_long_random_refresh_secret
# Access token lifetime (e.g. 15m, 1h). Default: 15m in production, 1h in development if unset.
# JWT_ACCESS_EXPIRES=15m

# ── CORS & URLs (set production URLs after deploy) ───────────────────────────
# Current Vite dev server runs on port 3000. Keep 5173 too in case you switch
# back to the default Vite port later.
CORS_ORIGIN=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:5173,http://localhost:5173
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://127.0.0.1:5000
SOCKET_CORS_ORIGIN=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:5173,http://localhost:5173

# ── Middlewares & Security ────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
HELMET_ENABLED=true
LOG_LEVEL=info

# ── Email Service ─────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="SESA Platform <noreply@sesa.edu>"

# ── AI Services ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=
# Primary OpenAI-compatible chat: Groq (https://console.groq.com)
GROQ_API_KEY=
# Optional; default when using Groq: llama-3.3-70b-versatile
# GROQ_MODEL=
# Optional fallback if you are not using Groq
# OPENAI_API_KEY=

# ── LangGraph agent (python-agents/) ─────────────────────────────────────────
# Backend proxies authenticated users to the external FastAPI process (dashboard + history in body).
# Run: cd python-agents && cp .env.example .env && pip install -r requirements.txt && ./run-dev.sh
# Base URL of the FastAPI process (no path). Node calls POST {LANGGRAPH_AGENT_URL}/v1/messages
LANGGRAPH_AGENT_URL=http://127.0.0.1:8088
# (python-agents only) In python-agents/.env: BACKEND_INTERNAL_API_BASE=http://127.0.0.1:5000/api
# Docker: http://host.docker.internal:5000/api or http://sesa-backend:5000/api

# ── OAuth Providers ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Stripe Payments ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ── LiveKit Streaming ─────────────────────────────────────────────────────────
# Get credentials from LiveKit Cloud or self-hosted instance
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Redis (Ephemeral State, Signaling & Cache) ───────────────────────────────
# Required in production for horizontal Socket.IO scaling, live signaling,
# collaboration rooms, and AI tutor session continuity.
# In local dev, leave blank unless you are also running Redis.
REDIS_URL=
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=

