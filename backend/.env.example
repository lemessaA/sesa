# ── Copy to .env and fill in values (never commit .env) ───────────────────────

# ── MongoDB Atlas (recommended for production / Render) ───────────────────────
# Create a cluster at https://www.mongodb.com/atlas → Database Access (user) →
# Network Access (allow 0.0.0.0/0 for Render/Vercel or restrict by IP).
#
# Use either variable name (both are supported; MONGODB_URI is copied to MONGO_URI if needed):
#
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/DATABASE_NAME?retryWrites=true&w=majority
#
# If your password has special characters (@ # : / ? etc.), URL-encode it in the URI.
# Example database name: sesaApp (matches the path segment before ?)

MONGO_URI=
# MONGODB_URI=   # optional alias — same as MONGO_URI

# Local development only: if MONGO_URI is unset and RENDER is not set, the app defaults to:
# mongodb://localhost:27017/sesa_db

# ── Core Server ───────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
APP_NAME=SESA Educational Platform
APP_VERSION=2.0.0

# ── Auth (required) ───────────────────────────────────────────────────────────
JWT_SECRET=your_long_random_jwt_secret_min_32_chars
JWT_REFRESH_SECRET=your_long_random_refresh_secret

# ── CORS & URLs (set production URLs after deploy) ───────────────────────────
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
SOCKET_CORS_ORIGIN=http://localhost:5173

# ── Middlewares & Security ────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
HELMET_ENABLED=true
LOG_LEVEL=info

# ── Email Service ─────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="SESA Platform <noreply@sesa.edu>"

# ── AI Services ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=
OPENAI_API_KEY=

# ── OAuth Providers ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Stripe Payments ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
